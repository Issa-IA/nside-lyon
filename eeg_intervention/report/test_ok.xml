<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record
    id="report_test_ok_etiquette"
    model="ir.actions.report"
  >
    <field name="name">Test 150E OK</field>
    <field name="model">carton.carton</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">eeg_intervention.report_test_ok</field>
    <field name="report_file">eeg_intervention.report_test_ok</field>
    <field name="attachment_use">True</field>
    <field name="print_report_name">'TEST OK - %s' % (object.name)</field>


  </record>
  
<template id="report_test_ok">
<t t-foreach="docs" t-as="doc">
<t t-foreach="doc.intervention_line_eeg_ids" t-as="table_line">
<t t-if="table_line.test == 1 or table_line.pile_test == 1">
<t t-out="table_line.serial_number_10"/>
</t>
</t>
</t>
</template>
</odoo>
