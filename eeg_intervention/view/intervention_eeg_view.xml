<odoo>
<data>
    <record id="sequence_project_task" model="ir.sequence">
            <field name="name">project tasksequence</field>
            <field name="code">project.tasksequence</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id"></field>
    </record>
    <record id="view_carton_tree" model="ir.ui.view">
        <field name="name">cartons.list</field>
        <field name="model">carton.carton</field>
        <field name="priority">4</field>
        <field name="arch" type="xml">
            <list string="Carton" class="" sample="1">
                <field name="name"/>
                <field name="model_carton"/>
                <field name="task_id"/>
                <field name="total_ok"/>
                <field name="total_hs"/>
                <field name="total_illisible" />
                <field name="total_casse" />

            </list>
        </field>
    </record>
<record model="ir.actions.act_window" id="carton_action_window">
                <field name="name">Cartons</field>
                <field name="res_model">carton.carton</field>
                <field name="view_mode">list</field> 
        </record>
        <menuitem
            parent="project.menu_project_config"
            id="menu_carton_form"
            groups="eeg_intervention.group_admin_rma"
            action="carton_action_window"/>

     <record id="task_form_line_intervention_eeg" model="ir.ui.view">
                <field name="name">form.line.intervention.eeg</field>
                <field name="model">carton.carton</field>
                <field name="arch" type="xml">
                    <form string="carton" duplicate="0">
                        <sheet string="Cartons">


                            <div class="oe_title">
                                 <h1>
                                    <field name="name" />
                                 </h1>
                            </div>
                                         <group name="intervention_header">
                                             <group name="intervention_details">
                                            <field name="model_carton" class="oe_inline"/>
                                            <field name="task_id" class="oe_inline"/>
                                            <field name ="nb_palette"/>
                                            <field name ="nb_carton"/>
                                            <field name ="transporteur"/>
                                            <field name ="poids_carton"/>
                                            <field name ="proprietaire_carton"/>

                                             </group>
                                            <group name="intervention_total">
                                                <field name="date_expedition"/>
                                                <field name="total_ok" class="oe_inline"/>
                                                <field name="total_hs" class="oe_inline"/>
                                                <field name="total_illisible" class="oe_inline"/>
                                                <field name="total_casse" class="oe_inline"/>
                                            </group>
                                         </group>

                        <notebook>
                       <page string="Details" name="lines">
                            <field name ="intervention_line_eeg_ids">
                             <list string="Lines eeg" create="true" editable="top" multi_edit="true">
                                    <field name="etiquette_id"/>
                                    <field name="serial_number_10"/>
                                    <field name="serial_number_36"/>
                                    <field name="task_id"/>
                                    <field name="carton_id"/>
                                    <field name="pile_test"/>
                                    <field name="test"/>
                                    <field name="code_erreur"/>
                                    <field name="affichage_defectueux"/>
                                    <field name="activation"/>
                                    <field name="piles"/>
                                    <field name="esthetique"/>
                                    <field name="cassees"/>
                                    <field name="remplace"/>
                                    <field name="related_archive_ids" widget="many2many_tags" options="{'no_create': True}" string="Related Tasks"/>


                             </list>
                            </field>

                        </page>
                      <page string="Recap" name="recap">
                          <group string="Recap" name="recap">
                              <field name ="pile_test"/>
                              <field name ="test"/>
                              <field name ="code_erreur"/>
                              <field name ="affichage_defectueux"/>
                              <field name ="activation"/>
                              <field name ="piles"/>
                              <field name ="esthetique"/>
                              <field name ="cassees"/>
                          </group>
                        </page>
                        <page string="Illisibles" name="illisible">
                            <field name ="intervention_line_illisible_ids">
                             <list string="Illisible eeg" create="true" editable="top" multi_edit="true">
                                    <field name="etiquette_id"/>
                                    <field name="qte_illisible"/>
                                    <field name="task_id"/>
                                    <field name="carton_id"/>
                             </list>
                            </field>
                        </page>
                        </notebook>
                          </sheet>

                         <chatter reload_on_follower="True"/>
                    </form>
                </field>

        </record>

    <record id="view_project_task_form" model="ir.ui.view">
            <field name="name">project.task.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                 <header>
                     <button name="create_sale_order" string="Créer Commande" type="object" class="oe_highlight" />
                     <button name="traitement_admin" string="Traitment admin" type="object" class="btn-primary"/>

                 </header>

                 <div class="oe_button_box" name="button_box">
                                 <button name="action_open_related_cartons" type="object" class="oe_stat_button"  icon="fa-cubes" groups="eeg_intervention.group_admin_rma">
                                    <field string="Cartons" name="cartons_count" widget="statinfo"/>
                                 </button>
                     <button name="action_open_related_etiquettes" string="Etiquettes" type="object" class="oe_stat_button"  icon="fa-credit-card" groups="eeg_intervention.group_admin_rma">
                                    <field string="Etiquettes" name="etiquette_count" widget="statinfo"/>
                     </button>
                        <button name="action_view_total_attente_remplacement" string="En attente de remplacement" type="object" class="oe_stat_button"  icon="fa-random" groups="eeg_intervention.group_admin_rma" 
                            invisible = "remplacement_active == False">
                                    <field string="En attente de remplacement" name="total_attente_remplacement" widget="statinfo"/>
                     </button>
                      <button name="action_open_related_archives_ids" string="Archives EEG" type="object" class="oe_stat_button"  icon="fa-credit-card" groups="eeg_intervention.group_admin_rma">
                                    <field string="Archives" name="archive_eeg_count" widget="statinfo"/>
                     </button>
                </div>
                <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='partner_id']" position="after">
                    <field name="shipping_address"/>
                </xpath>

  <xpath expr="//field[@name='shipping_address']" position="after">
    <field name="contact_store_id"/>
  </xpath>

  
                 <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='user_ids']" position="after">
                    <field name="x_studio_intervenant" string="Intervenant"/>
                    <field name="x_studio_marque" string="Marque"/>
                    <field name="date_reception"/>
                    <field name="date_expedition_tunisie"/>
                    <field name="date_expedition_france"/>
                    <field name="date_expedition"/>
                    <field name="date_reception_client"/>
                    <field name="task_url" invisible="1"/>
                  </xpath>
                <xpath expr="//page[@name='extra_info']" position="after">
                        <page string="RMA/RFB" name="gestion_rma" groups="eeg_intervention.group_admin_rma">
                             <group>
                                 <group>
                                     <field name="qte_annoncee"/>
                                    <field name="qte_recue"/>
                                    <field name="qte_non_traitee"/>
                                     <field name="sequence1"/>
                                     <field name="remplacement_active"/>
                                </group>
                                <group string="Images destruction">
                                  <field
                                    colspan="2"
                                    name="image_ids"
                                    context="{'default_name': name}"
                                    mode="kanban"
                                    nolabel="1"
                                >
                                    <kanban>
                                        <templates>
                                            <t t-name="card">
                                                <div class="oe_kanban_global_click p-2">
                                                    <field name="image" widget="image" class="img-fluid"/>
                                                    <div class="mt-2 text-center">
                                                        <field name="name"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                           </group>
                             </group>


                        </page>
                        <page string="Fiche consommation" name="studio_page_Lr9mG">
                          <group name="studio_group_Lr9mG">
                                <group name="studio_group_Lr9mG_left">
                                  <field name="num_cartons_client"/>
                                  <field name="transport_type"/>
                                  <field name="num_palette"/>
                                </group>
                                <group name="studio_group_Lr9mG_right">
                                  <field name="sale_order__intervention_id" string="Bon de commande RMA"/>
                                </group>
                          </group>
                          <field name="eeg_remplacee_ids" invisible="1"/>
                                  <field name="intervention_unique_ids">
                                    <list string="Intervention Unique">
                                      <field name="etiquette_id" optional="show"/>
                                      <field name="quantity_ok" optional="show"/>
                                      <field name="quantity_hs" optional="show"/>
                                      <field name="quantity_illisible" optional="show"/>
                                      <field name="quantity_cassees" optional="show"/>
                                      <field name="id" column_invisible="True"/>
                                    </list>
                                  </field>
                                  <field name="piles_ids">
                                    <list string="Pile">
                                      <field name="product_id" optional="show" string="Piles consommées"/>
                                      <field name="pile_factured" optional="show"/>
                                      <field name="pile_non_facture" optional="show"/>
                                      <field name="id" column_invisible="True"/>
                                    </list>
                                  </field>
                                  <field name="prestation_ids">
                                    <list string="prestation.model">
                                      <field name="etiquette_id" optional="show"/>
                                      <field name="product" optional="show"/>
                                      <field name="quantity" optional="show"/>
                                      <field name="price" optional="show" string="Prix"/>
                                      <field name="price_total" optional="show"/>
                                      <field name="id" column_invisible="True"/>
                                    </list>
                                  </field>
                 
                        </page>
                      
                    </xpath>
            </field>

</record>



</data>
</odoo>
